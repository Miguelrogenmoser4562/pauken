# DeepSeek API key for AI features (flashcards, quizzes, study chat, etc.)
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Server configuration
PORT=4180
HOST=127.0.0.1

# Postgres connection string — omit for local-only (in-browser) mode
DATABASE_URL=

# Path to users.json for multi-user mode
USERS_PATH=./users.json

# URL of self-hosted Whisper instance for audio transcription
WHISPER_API_URL=http://127.0.0.1:9000
