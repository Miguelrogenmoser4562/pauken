# Pauken Server Configuration
# Copy to .env and fill in your values.

# Server
HOST=0.0.0.0
PORT=4180

# Postgres
DATABASE_URL=postgres://pauken:pauken@localhost:5432/pauken

# User authentication (static keys for ~4 known users)
USERS_PATH=/etc/pauken/users.json

# Self-hosted Whisper instance (for audio transcription)
WHISPER_API_URL=http://127.0.0.1:9000

# DeepSeek API key (for AI generation — proxied through the server)
DEEPSEEK_API_KEY=sk-your-key-here
