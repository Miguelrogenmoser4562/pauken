[Unit]
Description=Pauken Whisper Transcription Service
After=network.target

[Service]
Type=simple
User=pauken
Group=pauken
WorkingDirectory=/opt/pauken

ExecStart=/usr/bin/whisper-server \
  --model ggml-large-v3-turbo.bin \
  --port 9000 \
  --host 127.0.0.1

Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
